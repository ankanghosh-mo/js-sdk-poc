    "approvedAt": "2026-11-18T10:00:00Z"
  },
  "routing": {
    "contextPath": "",
    "hashRouting": "auto",
    "stripExtensions": [
      ".jsp",
      ".do"
    ]
  },
  "maskingRules": {
    "defaults": {
      "maskChar": "*",
      "preserveSeparators": true,
      "onFormatMismatch": "FULL_MASK",
      "revealable": true,
      "revealTimeoutMs": 10000
    },
    "fields": {
      "AADHAAR": {
        "outcome": "POLICY",
        "masking": {
          "function": "PARTIAL_MASK",
          "params": {
            "showFirst": 0,
            "showLast": 4
          }
        }
      },
      "PAN": {
        "outcome": "POLICY",
        "masking": {
          "function": "RANGE_MASK",
          "params": {
            "from": -4,
            "to": -1
          }
        }
      },
      "MOBILE_NUMBER": {
        "outcome": "POLICY",
        "masking": {
          "function": "RANGE_MASK",
          "params": {
            "from": -9,
            "to": -5
          }
        }
      },
      "ACCOUNT_NUMBER": {
        "outcome": "POLICY",
        "masking": {
          "function": "FULL_MASK",
          "params": {}
        }
      },
      "ACCOUNT_BALANCE": {
        "outcome": "POLICY",
        "masking": {
          "function": "FULL_MASK",
          "params": {
            "fixedLength": 8
          }
        }
      },
      "CREDIT_CARD_NUMBER": {
        "outcome": "POLICY",
        "masking": {
          "function": "PATTERN_MASK",
          "params": {
            "template": "****-****-****-####",
            "inputFormat": "9999-9999-9999-9999"
          }
        }
      },
      "DATE_OF_BIRTH": {
        "outcome": "POLICY",
        "masking": {
          "function": "FULL_MASK",
          "params": {}
        }
      }
    }
  },
